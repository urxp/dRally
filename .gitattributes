# Line endings: LF inside the repository, platform native in the working tree - except for the files
# that are executed on Linux/devkitPro, which must keep LF even when checked out on Windows with
# core.autocrlf=true.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
Makefile.3ds text eol=lf
doc/3ds.md text eol=lf

# Visual Studio keeps CRLF in these - do not normalise them (upstream stores them that way, and a
# rewrite would show up as a huge, meaningless diff in a pull request)
*.sln     -text
*.vcxproj -text
*.filters -text
